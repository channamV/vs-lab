{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate && npm run build",
  "crons": [
    { "path": "/api/jobs/retention", "schedule": "17 3 * * *" },
    { "path": "/api/jobs/watchdog", "schedule": "*/5 * * * *" },
    { "path": "/api/jobs/schedules", "schedule": "* * * * *" }
  ]
}
