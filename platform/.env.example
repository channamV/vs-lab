# Copy to .env.local for local overrides. Never commit real values.

# PostgreSQL connection string. Leave unset locally to use the embedded database in .data/
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for the web pages. Unset = no sign-in (only acceptable on your own PC).
# ADMIN_PASSWORD=choose-a-long-password

# Accept data from devices that aren't registered yet (default true).
# DEVICE_AUTO_REGISTER=false
