# Copy to .env.local for local overrides. Never commit real values.

# PostgreSQL connection string. Leave unset locally to use the embedded database in .data/
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Platform admins (Veristart staff): sign in with this email and you can set up organizations.
# Without RESEND_API_KEY on your own PC, the sign-in link is printed in the terminal running the server.
PLATFORM_ADMIN_EMAILS=you@example.com

# Transition only: the old shared password, which signs in as the first platform admin.
# ADMIN_PASSWORD=choose-a-long-password

# Email (sign-in links and alerts) through resend.com.
# RESEND_API_KEY=re_...
# ALERT_EMAIL_FROM=VS Lab <alerts@yourdomain.com>

# Time zone for "engine hours per day" and clock times (default America/Toronto).
# APP_TIMEZONE=Europe/Dublin

# Accept data from new devices (default true). They're stored as "unclaimed" until a platform admin
# assigns them to an organization.
# DEVICE_AUTO_REGISTER=false
